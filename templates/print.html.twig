<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>{{ atendimento.senha }}</title>
    <style>
        @page {
            size: 80mm 100mm;
            margin: 3mm;
        }

        html, body {
            margin: 0;
            padding: 0;
        }

        #senha {
            text-align: center;
            margin: auto;
        }

        #senha * {
            font-family: monospace;
            font-size: 10pt;
            text-align: center;
            line-height: 1;
        }

        #senha header {
            font-size: 9pt;
            padding: 3pt 0;
        }

        #senha header p {
            margin: 0;
        }

        #senha header .unidade {
            font-size: 12pt;
            font-weight: bold;
            padding-bottom: 2pt;
        }

        #senha section {
            font-size: 9pt;
            padding: 4pt 0;
        }

        #senha section p {
            margin: 2px 0;
        }

        #senha section .prioridade {
            font-weight: bold;
        }

        #senha section .senha {
            font-size: 30pt;
            line-height: 36pt;
            font-weight: bold;
        }

        #senha section .data-hora {
            padding: 3pt 0;
        }

        #senha footer {
            font-size: 8pt;
            padding: 3pt 0;
        }

        #senha {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        #senha footer p {
            margin: 0;
        }
    </style>
    <link rel="shortcut icon" href="{{ asset('images/favicon.png') }}" />
</head>
<body>
    <div id="senha">
        <header>
            {% if atendimento.unidade.impressao.exibirNomeUnidade %}
                <p class="unidade">
                    {{ atendimento.unidade.nome }}
                </p>
            {% endif %}
            <p>
                {{ atendimento.unidade.impressao.cabecalho|nl2br }}
            </p>
        </header>
        <section>
            {% if atendimento.unidade.impressao.exibirPrioridade %}
                <p class="prioridade">
                    {{ atendimento.prioridade.nome }}
                </p>
            {% endif %}
            
            <p class="senha">
                {{ atendimento.senha }}
            </p>
            
            {% if atendimento.unidade.impressao.exibirNomeServico %}
                <p class="servico">
                    {{ atendimento.servico.nome }}
                </p>
            {% endif %}

            {% if atendimento.cliente and (atendimento.cliente.nome or atendimento.cliente.documento) %}
                <p class="cliente">
                    {% if atendimento.cliente.nome %}
                        Nome: {{ atendimento.cliente.nome }}
                    {% endif %}
                    {% set doc = atendimento.cliente.documento|default('') %}
                    {% if doc and doc|slice(0, 6) != 'TOTEM-' %}
                        <br>Doc: {{ doc }}
                    {% endif %}
                </p>
            {% endif %}

            {% if atendimento.local %}
                <p class="local">
                    Local: {{ atendimento.local.nome }}{% if atendimento.numeroLocal is not null %} {{ atendimento.numeroLocal }}{% endif %}
                </p>
            {% endif %}
            
            {% if atendimento.unidade.impressao.exibirMensagemServico %}
                <p class="servico">
                    {{ servicoUnidade.mensagem|nl2br }}
                </p>
            {% endif %}
            
            {% if atendimento.unidade.impressao.exibirData %}
                <div class="data-hora">
                    <p class="data">
                        {{ now|date('m/d/Y'|trans) }}
                    </p>
                    <p class="hora">
                        {{ 'print.ticket.date'|trans({ '%time%': now|date('H\\hi') })|raw }}
                    </p>
                </div>
            {% endif %}
        </section>
        <footer>
            <p>
                {{ atendimento.unidade.impressao.rodape|nl2br }}
            </p>
        </footer>
    </div>
</body>
</html>
